rules_version = '2';
// Regras do Firestore — Controle de Baterias (uso pessoal com código de acesso)
// Troque TROQUE-PELO-SEU-CODIGO pelo seu código (o mesmo que vai digitar no sistema)
// e cole em Firebase Console > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /acesso/{codigo}/{documento=**} {
      allow read, write: if codigo == 'TROQUE-PELO-SEU-CODIGO';
    }
  }
}
